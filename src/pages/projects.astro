---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Lab, Portfolio & Demo Work — Aleksey Bevz"
  description="Public lab, portfolio, demo, and developer-tooling projects focused on Kubernetes platform engineering, infrastructure automation, CI/CD, and operational practice."
>
  <Header />
  <main class="shell section page-top">
    <SectionHeading
      level={1}
      title="Selected Lab, Portfolio & Demo Work"
      intro="Public non-commercial lab, portfolio, demo, and developer-tooling artifacts. They complement, but do not replace, the production experience described in the profile."
    />
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
