---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title="Senior DevOps / Platform Engineer — Aleksey Bevz"
  description="Kubernetes-focused Senior DevOps / Platform Engineer with production on-premises platform experience and separate non-commercial lab and portfolio practice."
>
  <Header />
  <main class="shell section page-top">
    <SectionHeading
      level={1}
      title="Short-form Profile"
      intro="A concise factual summary of production platform experience, separate lab and portfolio practice, certifications, and current role fit."
    />

    <section class="cv-grid">
      <article class="note-card">
        <h3>Role Fit</h3>
        <p>
          Senior DevOps / Platform Engineer with more than four years
          responsible for an on-premises production Kubernetes platform—from
          the initial hands-on build to later architectural oversight.
          Secondary fit for hands-on Lead DevOps / Platform Tech Lead roles.
        </p>
      </article>
      <article class="note-card">
        <h3>Location</h3>
        <p>{profile.location}</p>
      </article>
      <article class="note-card">
        <h3>Core Strengths</h3>
        <p>
          Production core: Kubernetes, Linux, Jenkins/GitLab CI, Harbor,
          PostgreSQL/Patroni, Ceph, Istio, RabbitMQ, and Redis.
        </p>
        <p>
          Separate non-commercial lab and portfolio practice: AWS,
          OpenTofu/Terraform, Ansible, GitOps, Argo CD, Vault, External Secrets
          Operator, Kyverno, cosign, Prometheus, Grafana, and Loki.
        </p>
      </article>
      <article class="note-card">
        <h3>Certifications</h3>
        <p>{profile.certifications.slice(0, -1).join(" · ")}</p>
        <p>{profile.certifications[profile.certifications.length - 1]}</p>
      </article>
    </section>
  </main>
  <Footer />
</BaseLayout>
