---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillGroup from "../components/SkillGroup.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import { skillGroups } from "../data/skills";
---

<BaseLayout
  title="Aleksey Bevz — Senior DevOps / Platform Engineer | Kubernetes"
  description="Senior DevOps / Platform Engineer focused on production on-premises Kubernetes, Linux, CI/CD, and data-platform infrastructure, with separate lab and portfolio work in AWS, IaC, and GitOps."
>
  <Header />
  <main>
    <Hero {...profile} />

    <section class="shell section" id="projects">
      <SectionHeading
        title="Selected Portfolio, Lab & Demo Work"
        intro="Public portfolio, non-commercial lab, demo, and developer-tooling artifacts focused on Kubernetes platform engineering, infrastructure automation, CI/CD, and operational clarity."
      />
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <section class="shell section">
      <SectionHeading
        title="Core Strengths"
      />
      <div class="skill-grid">
        {skillGroups.map((group) => (
          <SkillGroup group={group} />
        ))}
      </div>
    </section>

    <section class="shell section split-section">
      <div>
        <SectionHeading
          title="Current Focus"
        />
        <ul class="focus-list">
          {profile.currentFocus.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <article class="contact-card contact-cta">
        <h3>Contact</h3>
        <p>{profile.contactText}</p>
        <ContactBlock
          emailUser={profile.emailUser}
          emailDomain={profile.emailDomain}
          github={profile.github}
          linkedin={profile.linkedin}
          location={profile.location}
        />
      </article>
    </section>
  </main>
  <Footer />
</BaseLayout>
